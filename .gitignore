# ROS 2 / colcon build artifacts (fully regenerated by `colcon build`)
build/
install/
log/

# Python
__pycache__/
*.pyc
*.egg-info/

# --- Gazebo Fuel world assets: NOT committed, fetched on setup instead ---
# (the Rubicon model is a verbatim copy of a public Fuel model; committing
# its ~300MB of meshes/textures would blow past GitHub's 100MB single-file
# limit on meshes/rubicon.dae alone. Run scripts/fetch_fuel_world.sh.)
src/ugv_sim/worlds/fuel/rubicon_world/models/Rubicon/

# --- vendored upstream reference repo (own nested .git, COLCON_IGNORE'd,
#     not needed to build or run the project -- see external/matrix_upstream) ---
external/matrix_upstream/

