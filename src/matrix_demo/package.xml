<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>matrix_demo</name>
  <version>0.0.1</version>
  <description>
    Master launch integration for the M.A.T.R.I.X Member-1+2+3 live
    demonstration (Gazebo + Rubicon + UGV + Member-2 perception + Member-3
    PIDNet + RViz + dashboard). Kept as a separate package so the frozen
    Member-1 ugv_sim package is never modified.
  </description>
  <maintainer email="noreply@example.com">matrix</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ugv_sim</exec_depend>
  <exec_depend>matrix_perception</exec_depend>
  <exec_depend>matrix_semantic</exec_depend>
  <exec_depend>matrix_navigation</exec_depend>
  <exec_depend>matrix_dashboard</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
